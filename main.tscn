[sub_resource type="GDScript" id="GDScript_na63q"]
resource_name = "Preload"
script/source = "extends Node2D


const PLATFORM_SETS: Array[PackedScene] = [
	preload(\"res://assets/sets/platform_preset_1.tscn\"),
	preload(\"res://assets/sets/platform_preset_2.tscn\"),
	preload(\"res://assets/sets/platform_preset_3.tscn\"),
	preload(\"res://assets/sets/platform_preset_4.tscn\"),
	preload(\"res://assets/sets/platform_preset_5.tscn\"),
	preload(\"res://assets/sets/platform_preset_6.tscn\"),
]

var next_spawn_y: float = -2000
var last_set: PackedScene = null

func _ready() -> void:
	for i in range(999):
		spawn_next_set()
		
func spawn_next_set() -> void:
	var chosen_set: PackedScene = PLATFORM_SETS.pick_random()
	#while chosen_set == last_set and PLATFORM_SETS.size() > 1:
		#chosen_set = PLATFORM_SETS.pick_random()
	#last_set = chosen_set

	var set_instance: Node2D = chosen_set.instantiate()
	set_instance.position = Vector2(0, next_spawn_y)
	add_child(set_instance)

	next_spawn_y -=1500

func game_over():
	
	get_tree().change_scene_to_file.call_deferred(\"res://game_over.tscn\")
	
func _on_kill_body_entered(body):
	if body.name == \"player\":
		game_over()
"

[sub_resource type="GDScript" id="GDScript_ul3f0"]
script/source = "extends CharacterBody2D

const SPEED = 500.0
const JUMP_VELOCITY = -2200.0
var DOUBLE_JUMPED := true
@export var sprite_2d: Sprite2D


func _physics_process(delta: float) -> void:
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * 5 * delta
	else:
		DOUBLE_JUMPED = false
	# Handle jump.
	if (is_on_floor() or !DOUBLE_JUMPED) and Input.is_action_just_pressed(\"ui_accept\"):
		velocity.y = JUMP_VELOCITY
		if !is_on_floor():
			DOUBLE_JUMPED = true
	# Get the input direction and handle the movement/deceleration.
	# As good practice, you should replace UI actions with custom gameplay actions.
	var direction := Input.get_axis(\"ui_left\", \"ui_right\")
	if direction:
		velocity.x = direction * SPEED
		sprite_2d.scale.x = direction
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

	move_and_slide()
	
"

